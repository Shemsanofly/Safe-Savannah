# Copy to .env and adjust. Every value has a default; see src/config.ts.

# --- Database (PostgreSQL 14+) ---
DATABASE_URL=postgres://savannah:savannah@127.0.0.1:5432/safe_savannah

# --- Dashboard / API ---
HOST=127.0.0.1                 # keep on localhost unless other duty devices must reach it
PORT=8080
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
SESSION_HOURS=12               # roughly one shift
COOKIE_SECURE=false            # true when served over HTTPS
TIMEZONE=Africa/Dar_es_Salaam

# --- Camera + zone ---
CAMERA_ID=cam-1
CAMERA_LABEL=Approach camera 1
CAMERA_SOURCE=fixtures/synthetic-crossing.mp4   # video file, /dev/video0, or rtsp://...
CAMERA_LOOP=true               # loop a replay file
CAMERA_REALTIME=true           # read a file at native speed, like a live camera
CAMERA_INPUT_ARGS=             # e.g. "-video_size 1280x720" for a USB camera
ZONES_FILE=config/zones.json
STALE_FEED_SECONDS=5

# --- Detector ---
DETECTOR=scripted              # onnx = real YOLO inference; scripted = SIMULATED boxes for the synthetic clip
MODEL_MANIFEST=models/yolo11n.manifest.json
SCRIPTED_TIMELINE=fixtures/synthetic-crossing.timeline.json
TARGET_CLASS=elephant
# Tuning defaults, NOT validated safety limits:
SAMPLE_FPS=5
CONFIDENCE_THRESHOLD=0.45
CONSECUTIVE_FRAMES=3
CLEAR_SECONDS=10
MAX_FRAME_GAP_MS=1500

# --- SMS / Voice via Africa's Talking ---
# SMS is sent through the Africa's Talking API. In the sandbox, messages appear in the
# AT simulator (https://simulator.africastalking.com) for the recipient's number —
# nothing is faked inside this web app. Without AT_API_KEY, messages are NOT sent;
# the notifier logs a warning and records the failure in the notification outbox.
SMS_PROVIDER=africastalking    # africastalking | mock (mock = labelled offline simulation)
AT_ENVIRONMENT=sandbox         # sandbox | live
AT_USERNAME=sandbox            # always "sandbox" for the sandbox app
AT_API_KEY=                    # your sandbox app's API key (Settings → API Key in the AT sandbox dashboard)
AT_SENDER_ID=
SMS_RECIPIENTS=duty:+255700000000   # gate-camera duty phone(s): alias:number,alias2:number
SMS_TEST_MODE=true             # adds "TEST" to every message
SMS_FRESHNESS_SECONDS=300      # agree this with the duty team
SMS_RETRY_CAP_SECONDS=60
SMS_TIMEOUT_MS=10000
# Voice: AT's voice sandbox is not operational, so calls are simulated (and labelled)
# unless you have a provisioned live AT voice number.
VOICE_PROVIDER=simulated       # simulated | africastalking
AT_VOICE_NUMBER=
EMERGENCY_LINE=112             # shown to tourists; confirm the right number with the park/lodge

# --- Camera simulator (labelled SIMULATED detections for demos) ---
SIMULATOR_ENABLED=true
SIMULATOR_INTERVAL_SECONDS=60

# --- Provider callbacks (delivery reports, USSD) ---
# Expose ONLY the webhook listener through an HTTPS tunnel, never the dashboard port.
WEBHOOK_TOKEN=
WEBHOOK_PORT=8081              # tunnel this port: ngrok http 8081
WEBHOOK_HOST=127.0.0.1
PUBLIC_WEBHOOK_URL=            # https://<your tunnel> (used for voice keypad callbacks)
USSD_ENABLED=false            # set true after generating WEBHOOK_TOKEN (at least 16 characters)
USSD_ALLOWLIST=                # extra ranger phones: +2557XXXXXXXX:operatorId (ranger phones on their accounts work too)

DEMO_CONTROLS=true
LOG_LEVEL=info
