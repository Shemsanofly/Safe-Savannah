# Copy to .env and adjust. Every value has a default; see src/config.ts.

# --- Database (PostgreSQL 14+) ---
DATABASE_URL=postgres://savannah:savannah@127.0.0.1:5432/safe_savannah

# --- Dashboard / API ---
HOST=127.0.0.1                 # keep on localhost unless other duty devices must reach it
PORT=8080
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
SESSION_HOURS=12               # roughly one shift
COOKIE_SECURE=false            # true when served over HTTPS
TIMEZONE=Africa/Dar_es_Salaam

# --- Camera + zone ---
CAMERA_ID=cam-1
CAMERA_LABEL=Approach camera 1
CAMERA_SOURCE=fixtures/synthetic-crossing.mp4   # video file, /dev/video0, or rtsp://...
CAMERA_LOOP=true               # loop a replay file
CAMERA_REALTIME=true           # read a file at native speed, like a live camera
CAMERA_INPUT_ARGS=             # e.g. "-video_size 1280x720" for a USB camera
ZONES_FILE=config/zones.json
STALE_FEED_SECONDS=5

# --- Detector ---
DETECTOR=scripted              # onnx = real YOLO inference; scripted = SIMULATED boxes for the synthetic clip
MODEL_MANIFEST=models/yolo11n.manifest.json
SCRIPTED_TIMELINE=fixtures/synthetic-crossing.timeline.json
TARGET_CLASS=elephant
# Tuning defaults, NOT validated safety limits:
SAMPLE_FPS=5
CONFIDENCE_THRESHOLD=0.45
CONSECUTIVE_FRAMES=3
CLEAR_SECONDS=10
MAX_FRAME_GAP_MS=1500

# --- SMS ---
SMS_PROVIDER=mock              # mock | africastalking
SMS_RECIPIENTS=duty:+255700000000   # approved duty/test numbers only: alias:number,alias2:number
SMS_TEST_MODE=true             # adds "TEST" to every message
SMS_FRESHNESS_SECONDS=300      # agree this with the duty team
SMS_RETRY_CAP_SECONDS=60
SMS_TIMEOUT_MS=10000
AT_ENVIRONMENT=sandbox         # sandbox | live
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=

# --- Provider callbacks (delivery reports, USSD) ---
# Expose ONLY the webhook listener through an HTTPS tunnel, never the dashboard port.
WEBHOOK_TOKEN=
WEBHOOK_PORT=
WEBHOOK_HOST=127.0.0.1
USSD_ENABLED=false
USSD_ALLOWLIST=                # +2557XXXXXXXX:operatorId,...

DEMO_CONTROLS=true             # shows the simulated-uplink toggle (mock SMS only)
LOG_LEVEL=info
